APP_ENV=production
DOMAIN=https://aitradebot.work.gd
POSTGRES_DB=ai_trader
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=
# Use a public HTTPS URL for live checkout; NOWPayments cannot call localhost.
PUBLIC_BASE_URL=https://aitradebot.work.gd
TRUSTED_HOSTS=["localhost","127.0.0.1","aitradebot.work.gd"]
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
ALLOW_PUBLIC_SIGNUP=true
# Generate with: openssl rand -base64 48. Keep it persistent; changing it logs everyone out.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=14
USER_SECRETS_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAILS=[]

# Crypto payment checkout. Keep disabled until NOWPayments credentials and the
# public HTTPS callback URL are configured.
PAYMENT_PROVIDER=disabled
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Leave these production defaults in place for real payments. Use the sandbox
# values below only with a separate sandbox account/key. Sandbox success must
# still come from NOWPayments status/IPN; the application never fakes success.
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_SANDBOX=false
# Sandbox keys are separate from live keys. Set true only with sandbox API and
# IPN credentials; NOWPayments controls the test payment lifecycle.
# NOWPAYMENTS_SANDBOX=true
BILLING_CURRENCY=usd
ENABLE_REAL_TRADING=false
MANUAL_TRADING_ONLY=true

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_SCANNER=openai/gpt-oss-120b:free
OPENROUTER_MODEL_JUDGE=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=AI Trader Copilot
ALLOW_PLATFORM_AI_FALLBACK=false
REQUIRE_AI_FOR_SIGNAL_PUBLICATION=true

OPENAI_API_KEY=
OPENAI_MODEL_SCANNER=gpt-5.4-mini
OPENAI_MODEL_JUDGE=gpt-5.5

AI_MAX_CALLS_PER_ANALYSIS=1
AI_MONTHLY_BUDGET_USD=10
# Conservative reservation used to hard-stop platform-funded AI before its
# configured monthly ceiling. Set this above your highest expected call cost.
AI_ESTIMATED_COST_PER_CALL_USD=0.01

BINANCE_PUBLIC_BASE_URL=https://api.binance.com
BINANCE_STREAM_BASE_URL=wss://stream.binance.com:9443
# Free public cross-venue microstructure feeds. One process-wide connection is
# One bounded execution tape shared by all users. No exchange API key is
# required: Binance and Bybit spot/perpetual public streams are used.
MULTI_VENUE_WS_ENABLED=true
BINANCE_SPOT_PUBLIC_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_PERP_PUBLIC_WS_URL=wss://fstream.binance.com/market/stream
BINANCE_FUTURES_MARKET_WS_URL=wss://fstream.binance.com/market/stream
BINANCE_FUTURES_BOOK_WS_URL=wss://fstream.binance.com/public/stream
BINANCE_FUTURES_MINI_TICKER_WS_URL=wss://fstream.binance.com/market/ws/!miniTicker@arr
BYBIT_SPOT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_PERP_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear
MULTI_VENUE_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
MULTI_VENUE_MAX_SYMBOLS=12
MULTI_VENUE_SYMBOL_IDLE_SECONDS=30
MULTI_VENUE_BOOK_LEVELS=200
MULTI_VENUE_MIN_BOOK_LEVELS=5
MULTI_VENUE_MAX_EVENTS=2000
MULTI_VENUE_STALE_SECONDS=30
MULTI_VENUE_TRADE_WINDOW_SECONDS=60
MULTI_VENUE_LIQUIDATION_WINDOW_SECONDS=300
MULTI_VENUE_FLOW_WARMUP_SECONDS=10
MULTI_VENUE_MIN_FLOW_TRADES=20
MULTI_VENUE_MIN_FLOW_NOTIONAL_USD=5000
EXECUTION_TAPE_LARGE_TRADE_NOTIONAL_USD=10000
MULTI_VENUE_MAX_EVENT_LAG_SECONDS=10
MULTI_VENUE_SUBSCRIPTION_RETRY_SECONDS=900

GDELT_DOC_API=https://api.gdeltproject.org/api/v2/doc/doc
# Performance guardrails. These values work well on a small 1–2 GB Docker host.
# Keep background jobs enabled in exactly one app process when scaling workers.
MARKET_SNAPSHOT_CACHE_SECONDS=30
MARKET_SNAPSHOT_CACHE_MAX_ENTRIES=96
MARKET_INTELLIGENCE_MAX_CONCURRENCY=8
ANALYSIS_STREAM_MAX_PAIRS=32
ANALYSIS_STREAM_IDLE_SECONDS=30
ANALYSIS_COMPUTE_MAX_CONCURRENCY=4
ANALYSIS_COMPUTE_WAIT_SECONDS=20
ANALYSIS_LIVE_REFRESH_SECONDS=10
ANALYSIS_WEBSOCKET_CONFIG_TIMEOUT_SECONDS=10
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_IDLE_CHECK_SECONDS=60
RADAR_MAX_STALE_MULTIPLIER=6

DEFAULT_ACCOUNT_SIZE_USD=1000
DEFAULT_RISK_PER_IDEA_PCT=0.5
MIN_RISK_REWARD=1.5
MAX_DRAWDOWN_PCT=12
MAX_GROSS_EXPOSURE_PCT=100

# Institutional controls: capital allocation remains WAIT until a validated
# model is active and current account drawdown is supplied.
INSTITUTIONAL_REQUIRE_VALIDATED_MODEL=false
INSTITUTIONAL_MIN_FORECAST_CONFIDENCE=0.15
INSTITUTIONAL_REQUIRE_PORTFOLIO_STATE=false
INSTITUTIONAL_UNVALIDATED_RISK_CAP_PCT=0.25
INSTITUTIONAL_MISSING_PORTFOLIO_RISK_CAP_PCT=0.25
INSTITUTIONAL_MIN_DIRECTIONAL_ENGINES=2
INSTITUTIONAL_MAX_LEVERAGE=5
INSTITUTIONAL_EXPECTED_PAYOFF_R=2.5
INSTITUTIONAL_FEE_BPS_PER_SIDE=3.0
INSTITUTIONAL_SLIPPAGE_BPS_PER_SIDE=0.5
INSTITUTIONAL_MIN_STOP_DISTANCE_BPS=25.0
PORTFOLIO_CURRENT_DRAWDOWN_PCT=
