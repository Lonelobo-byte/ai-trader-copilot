{$DOMAIN} {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https: wss:"
	}
	request_body {
		max_size 1MB
	}
	@versionedStatic path /static/*.css /static/*.js
	header @versionedStatic Cache-Control "public, max-age=31536000, immutable"
	@staticHtml path /static/*.html
	header @staticHtml Cache-Control "no-cache, max-age=0"

	# Serve immutable frontend assets directly from Caddy. This removes Python
	# request/serialization overhead for every page, stylesheet and script.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy app:8000
	}
}
