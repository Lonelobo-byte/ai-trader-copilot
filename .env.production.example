# Copy to .env on the server. Do not commit the completed .env file.
APP_ENV=production
DOMAIN=app.example.com
PUBLIC_BASE_URL=https://app.example.com
TRUSTED_HOSTS=["app.example.com"]

# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_DB=ai_trader
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=replace-with-a-64-character-hex-password

# Generate once and preserve it: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-persistent-random-secret
# Optional dedicated encryption secret for user-owned OpenRouter keys. If it
# is blank, AUTH_JWT_SECRET is used; keep either value persistent.
USER_SECRETS_ENCRYPTION_KEY=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=14
ALLOW_PUBLIC_SIGNUP=true
BOOTSTRAP_ADMIN_EMAILS=[]
SUBSCRIPTION_ENFORCEMENT_ENABLED=true

# AI provider
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL_SCANNER=openrouter/free
OPENROUTER_MODEL_JUDGE=openrouter/free
OPENROUTER_HTTP_REFERER=https://app.example.com
OPENROUTER_APP_TITLE=AI Trader Copilot
# Member dashboard requests use their own OpenRouter keys by default.
ALLOW_PLATFORM_AI_FALLBACK=false
REQUIRE_AI_FOR_SIGNAL_PUBLICATION=true

# NOWPayments live credentials. Use sandbox values only on a staging domain.
PAYMENT_PROVIDER=nowpayments
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_API_KEY=replace-with-nowpayments-live-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret
BILLING_CURRENCY=usd

ENABLE_REAL_TRADING=false
MANUAL_TRADING_ONLY=true

# Performance guardrails. For multiple web workers/replicas, set this false on
# all web processes and run exactly one dedicated process with it set to true.
MARKET_SNAPSHOT_CACHE_SECONDS=8
MARKET_SNAPSHOT_CACHE_MAX_ENTRIES=96
MARKET_INTELLIGENCE_MAX_CONCURRENCY=8
ANALYSIS_STREAM_MAX_PAIRS=32
ANALYSIS_STREAM_IDLE_SECONDS=30
ANALYSIS_COMPUTE_MAX_CONCURRENCY=4
ANALYSIS_COMPUTE_WAIT_SECONDS=20
ANALYSIS_LIVE_REFRESH_SECONDS=5
ANALYSIS_WEBSOCKET_CONFIG_TIMEOUT_SECONDS=10
MULTI_VENUE_SYMBOL_IDLE_SECONDS=30
RADAR_MAX_STALE_MULTIPLIER=6
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_IDLE_CHECK_SECONDS=60
