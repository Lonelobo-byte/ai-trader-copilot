<!DOCTYPE html><html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Market Discovery Radar | APEX AI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0c0d14;
      --panel-bg: #151621;
      --card-bg: #151621;
      --border-color: rgba(255, 255, 255, 0.05);
      --text-primary: #fcfcfc;
      --text-secondary: #a1a5b7;
      --text-muted: #5e6278;
      --neon-green: #50cd89;
      --neon-red: #f1416c;
      --neon-blue: #3e97ff;
      --neon-gold: #f1bc00;
      --neon-purple: #7239ea;
      --font-sans: 'Inter', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    html { background-color: var(--bg-color); color: var(--text-primary); font-family: var(--font-sans); }

    .glow-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(140px);
      opacity: 0.12;
      mix-blend-mode: screen;
      pointer-events: none;
      z-index: -1;
    }

    .radar-scope {
      position: relative;
      background: rgba(0,0,0,0.3);
      border-radius: 50%;
      overflow: hidden;
    }
    
    .radar-sweep {
      position: absolute;
      inset: 0;
      background: conic-gradient(from 0deg, rgba(62, 151, 255, 0.4), transparent 30%);
      animation: sweep 4s linear infinite;
    }

    @keyframes sweep {
      to { transform: rotate(360deg); }
    }

    .radar-grid-circle { position: absolute; inset: 10%; border: 1px solid rgba(255,255,255,0.05); border-radius: 50%; }
    .radar-grid-circle-inner { position: absolute; inset: 30%; border: 1px solid rgba(255,255,255,0.05); border-radius: 50%; }
    .radar-crosshair-h { position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: rgba(255,255,255,0.05); }
    .radar-crosshair-v { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgba(255,255,255,0.05); }

    .radar-table th { background: rgba(0, 0, 0, 0.12); border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .radar-table td { border-bottom: 1px solid rgba(255, 255, 255, 0.04); }
    .sticky-action { position: sticky; right: 0; background: rgba(12, 13, 20, 0.98); backdrop-filter: blur(8px); }

    .evidence-radar-orbit span {
      background: conic-gradient(from 0deg, rgba(62, 151, 255, .4), transparent 30%);
      animation: evidence-sweep 3.5s linear infinite;
    }

    @keyframes evidence-sweep { to { transform: rotate(360deg); } }

    .badge-verified {
      background: rgba(80, 205, 137, 0.18); color: #50cd89; border: 1px solid rgba(80, 205, 137, 0.5);
      box-shadow: 0 0 8px rgba(80, 205, 137, 0.25);
    }

    .priority-badge { font-size: 0.72rem; font-weight: 600; padding: 3px 10px; border-radius: 6px; }
    .priority-badge.high { background: rgba(251, 191, 36, 0.1); color: var(--neon-gold); border: 1px solid rgba(251, 191, 36, 0.2); }

    .lifecycle-box {
      border: 1px solid rgba(80, 205, 137, .22);
      background: rgba(80, 205, 137, .045);
      padding: .38rem .42rem;
      border-radius: 6px;
    }
  </style>
</head>
<body>
  <div class="min-h-screen bg-[#0c0d14] flex" data-sd-id="1">
    
    <!-- Sidebar Component Reference -->
    <sd-component componentid="a9d5662b-3c5d-4257-8f43-200367ae6664" name="ApexSidebar" props="{&quot;activeItem&quot;: &quot;radar&quot;}"></sd-component>

    <div class="flex-1 flex flex-col ml-[76px]" data-sd-id="2">
      <!-- Header Component Reference -->
      <sd-component componentid="f67e4635-8a86-425b-b013-94db36c7c560" name="RadarTopHeader" props="{&quot;showEngineStatus&quot;: true}"></sd-component>

      <main class="p-6 max-w-[1440px] mx-auto w-full space-y-6" data-sd-id="3">
        
        <!-- Summary Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5" data-sd-id="4">
          <!-- Aligned Contexts -->
          <div class="bg-[#151621] p-6 rounded-[14px] border-l-[3px] border-[#7239ea] border-y border-r border-white/5 relative shadow-lg" data-sd-id="5">
            <h3 class="text-[#a1a5b7] text-[0.7rem] font-bold uppercase tracking-[0.09em] mb-4 pb-3 border-b border-white/5" data-sd-id="6">Aligned Contexts</h3>
            <div class="flex justify-between items-end gap-4 mt-2" data-sd-id="7">
              <h2 class="text-[2rem] font-bold leading-none" data-sd-id="8">14</h2>
              <span class="text-[#5e6278] text-[0.62rem] font-bold uppercase tracking-wider text-right" data-sd-id="9">live-confirmed review candidates</span>
            </div>
          </div>

          <!-- Highest Evidence Score -->
          <div class="bg-[#151621] p-6 rounded-[14px] border-l-[3px] border-[#f1bc00] border-y border-r border-white/5 relative shadow-lg" data-sd-id="10">
            <h3 class="text-[#a1a5b7] text-[0.7rem] font-bold uppercase tracking-[0.09em] mb-4 pb-3 border-b border-white/5" data-sd-id="11">Highest Evidence Score</h3>
            <div class="flex justify-between items-end gap-4 mt-2" data-sd-id="12">
              <h2 class="text-[2rem] font-bold leading-none font-mono text-[#f1bc00]" data-sd-id="13">88</h2>
              <span class="text-[#fcfcfc] text-[0.62rem] font-bold uppercase tracking-wider text-right" data-sd-id="14">BTC/USDT</span>
            </div>
          </div>

          <!-- Volatility Regime -->
          <div class="bg-[#151621] p-6 rounded-[14px] border-l-[3px] border-[#3e97ff] border-y border-r border-white/5 relative shadow-lg" data-sd-id="15">
            <h3 class="text-[#a1a5b7] text-[0.7rem] font-bold uppercase tracking-[0.09em] mb-4 pb-3 border-b border-white/5" data-sd-id="16">Volatility Regime</h3>
            <div class="flex justify-between items-end gap-4 mt-2" data-sd-id="17">
              <h2 class="text-[1.5rem] font-bold leading-none text-[#3e97ff]" data-sd-id="18">STABLE</h2>
              <span class="text-[#5e6278] text-[0.62rem] font-bold uppercase tracking-wider text-right" data-sd-id="19">dominant realized-volatility state</span>
            </div>
          </div>

          <!-- Radar Scope -->
          <div class="bg-[#151621] p-4 rounded-[14px] border border-white/5 relative flex flex-col items-center justify-center min-h-[105px]" data-sd-id="20">
            <h3 class="absolute top-4 left-6 text-[#a1a5b7] text-[0.65rem] font-bold uppercase tracking-widest" data-sd-id="21">Live Scan Telemetry</h3>
            <div class="radar-scope w-[80px] h-[80px] border border-white/10 mt-4" data-sd-id="22">
              <div class="radar-sweep" data-sd-id="23"></div>
              <div class="radar-grid-circle" data-sd-id="24"></div>
              <div class="radar-grid-circle-inner" data-sd-id="25"></div>
              <div class="radar-crosshair-h" data-sd-id="26"></div>
              <div class="radar-crosshair-v" data-sd-id="27"></div>
              <div class="absolute w-1 h-1 bg-[#3e97ff] rounded-full shadow-[0_0_8px_#3e97ff]" style="top: 25%; left: 70%;" data-sd-id="28"></div>
              <div class="absolute w-1 h-1 bg-[#f1416c] rounded-full shadow-[0_0_8px_#f1416c]" style="top: 70%; left: 30%;" data-sd-id="29"></div>
            </div>
          </div>
        </div>

        <!-- Filter & Control Bar -->
        <div class="bg-[#0d1423]/35 p-3 px-5 rounded-xl border border-white/5 flex flex-wrap items-center justify-between gap-4" data-sd-id="30">
          <div class="flex gap-2" data-sd-id="31">
            <button class="px-3.5 py-1.5 rounded-full text-[0.8rem] font-semibold bg-white/10 text-white border border-white/10" data-sd-id="32">All Contexts</button>
            <button class="px-3.5 py-1.5 rounded-full text-[0.8rem] font-semibold text-[#5e6278] hover:text-[#a1a5b7] transition-colors" data-sd-id="33">Review Candidates</button>
            <button class="px-3.5 py-1.5 rounded-full text-[0.8rem] font-semibold text-[#5e6278] hover:text-[#a1a5b7] transition-colors" data-sd-id="34">Bullish Context</button>
          </div>

          <div class="flex items-center gap-4" data-sd-id="35">
            <div class="flex items-center gap-3" data-sd-id="36">
              <label class="text-[0.8rem] font-semibold text-[#a1a5b7]" data-sd-id="37">Scan Mode:</label>
              <select class="bg-[#080e18]/90 border border-white/5 text-white text-[0.8rem] font-semibold py-1.5 px-4 rounded-lg outline-none cursor-pointer" data-sd-id="38">
                <option data-sd-id="39">🕒 Intraday Scan (15m / 4h)</option>
                <option data-sd-id="40">⚡ Scalp Scan (5m / 1h)</option>
                <option data-sd-id="41">📅 Swing Scan (1h / 1d)</option>
              </select>
            </div>
            <button class="flex items-center gap-2 bg-[#3e97ff]/10 border border-[#3e97ff]/40 text-[#b9d8ff] px-3 py-1.5 rounded-lg text-[0.76rem] font-extrabold hover:bg-[#3e97ff]/20 transition-all" data-sd-id="42">
              <span data-sd-id="43">Build Top-3 Research Briefs</span>
              <span class="bg-[#50cd89]/10 border border-[#50cd89]/35 text-[#50cd89] font-mono text-[0.58rem] px-1.5 py-0.5 rounded" data-sd-id="44">READY</span>
            </button>
          </div>

          <div class="flex items-center gap-2 text-[0.78rem] text-[#5e6278]" data-sd-id="45">
            <span class="w-3 h-3 border-2 border-white/10 border-t-[#3e97ff] rounded-full" data-sd-id="46"></span>
            <span data-sd-id="47">Next scan in 30s</span>
          </div>
        </div>

        <!-- Opportunities Table -->
        <div class="bg-[#151621] rounded-xl border border-white/5 shadow-sm overflow-hidden" data-sd-id="48">
          <table class="w-full text-left border-collapse radar-table" data-sd-id="49">
            <thead data-sd-id="50">
              <tr class="text-[0.72rem] font-bold uppercase tracking-wider text-[#5e6278]" data-sd-id="51">
                <th class="p-[1.1rem_1.25rem]" data-sd-id="52">Symbol / Causal Thesis</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="53">Causal Score</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="54">Regime &amp; Vol</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="55">Liquidity Reference</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="56">Price × OI</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="57">Order Flow</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="58">Evidence Coverage</th>
                <th class="p-[1.1rem_1.25rem]" data-sd-id="59">Review Status</th>
                <th class="p-[1.1rem_1.25rem] sticky-action z-10 shadow-[-10px_0_18px_rgba(0,0,0,0.2)]" data-sd-id="60">Action</th>
              </tr>
            </thead>
            <tbody class="text-[0.85rem]" data-sd-id="61">
              <!-- High Priority Row -->
              <tr class="hover:bg-white/[0.015] border-l-[3px] border-[#50cd89] bg-[#50cd89]/[0.02]" data-sd-id="62">
                <td class="p-4 px-5" data-sd-id="63">
                  <div class="flex flex-col gap-1" data-sd-id="64">
                    <strong class="text-[0.95rem] font-bold text-white">BTC/USDT</strong>
                    <span class="top-badge-tag badge-verified self-start" data-sd-id="65">BULLISH FRESH-EVENT CONTEXT</span>
                    <span class="text-[0.62rem] text-[#5e6278]" data-sd-id="66">Evidence aligned so far</span>
                  </div>
                </td>
                <td class="p-4" data-sd-id="67">
                  <div class="flex items-center gap-3" data-sd-id="68">
                    <span class="font-mono font-semibold text-[#50cd89] w-8 text-right" data-sd-id="69">88</span>
                    <div class="flex-1 h-1.5 bg-white/5 rounded-full overflow-hidden max-w-[100px]" data-sd-id="70">
                      <div class="h-full bg-[#50cd89] shadow-[0_0_8px_rgba(80,205,137,0.15)]" style="width: 88%" data-sd-id="71"></div>
                    </div>
                  </div>
                </td>
                <td class="p-4" data-sd-id="72">
                  <div class="flex flex-col gap-2" data-sd-id="73">
                    <span class="inline-block text-[0.7rem] font-bold bg-[#10b981]/10 text-[#50cd89] border border-[#10b981]/20 px-2 py-0.5 rounded uppercase tracking-wide" data-sd-id="74">BREAKOUT · STABLE</span>
                    <div class="lifecycle-box" data-sd-id="75">
                      <span class="block text-[#50cd89] font-mono font-extrabold text-[0.48rem] tracking-wider uppercase" data-sd-id="76">ACTIONABLE</span>
                      <strong class="block text-[#a1a5b7] font-mono text-[0.54rem] leading-[1.3] uppercase">FVG-CANDLE VALID</strong>
                    </div>
                  </div>
                </td>
                <td class="p-4 font-mono text-[#a1a5b7]" data-sd-id="77">INTERNAL_POOL · 94,201.50</td>
                <td class="p-4 font-mono text-[#a1a5b7]" data-sd-id="78">ACCUMULATION · 4.12%</td>
                <td class="p-4 font-mono" data-sd-id="79">
                  <span class="text-[#a1a5b7]" data-sd-id="80">BULLISH_BIAS</span>
                  <span class="block mt-1 text-[0.58rem] text-[#5e6278]" data-sd-id="81">Bybit + Coinbase: SYNCED</span>
                </td>
                <td class="p-4 font-mono text-[#a1a5b7]" data-sd-id="82">4/4 domains</td>
                <td class="p-4" data-sd-id="83"><span class="priority-badge high" data-sd-id="84">REVIEW CANDIDATE</span></td>
                <td class="p-4 sticky-action" data-sd-id="85">
                  <div class="flex gap-1.5" data-sd-id="86">
                    <button class="px-3 py-1 bg-white/5 border border-white/5 rounded-md text-[0.78rem] font-semibold hover:bg-[#3e97ff] hover:text-black transition-all" data-sd-id="87">Review</button>
                    <button class="px-3 py-1 bg-white/[0.025] border border-white/10 rounded-md text-[0.78rem] font-semibold text-[#a1a5b7] hover:bg-[#3e97ff]/10 hover:border-[#3e97ff]/50" data-sd-id="88">Research ↗</button>
                  </div>
                </td>
              </tr>

              <!-- Placeholder Loading Logic - Pure Reproduction Visual -->
              <tr data-sd-id="89">
                <td colspan="9" class="p-0" data-sd-id="90">
                   <div class="flex items-center gap-12 justify-center max-w-[780px] mx-auto min-h-[220px] p-8" data-sd-id="91">
                      <div class="evidence-radar-orbit w-[74px] h-[74px] relative bg-[radial-gradient(circle,rgba(62,151,255,0.12),rgba(62,151,255,0.025)_48%,transparent_70%)] border border-[#3e97ff]/30 rounded-full" data-sd-id="92">
                        <span class="absolute inset-0 rounded-full" data-sd-id="93"></span>
                        <i class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-[#3e97ff] rounded-full shadow-[0_0_14px_#3e97ff]"></i>
                      </div>
                      <div class="flex-1 space-y-2" data-sd-id="94">
                        <div class="flex items-center gap-2 text-[#3e97ff] font-mono font-extrabold text-[0.61rem] tracking-[0.15em] uppercase" data-sd-id="95">
                          <span class="w-1.5 h-1.5 bg-[#3e97ff] rounded-full shadow-[0_0_9px_#3e97ff]" data-sd-id="96"></span>
                          Live collection in progress
                        </div>
                        <h3 class="text-white text-[1.02rem] font-bold" data-sd-id="97">Acquiring market evidence</h3>
                        <p class="text-[#5e6278] text-[0.72rem]" data-sd-id="98">Mapping the current context before Radar ranks any opportunity.</p>
                        <div class="grid grid-cols-3 gap-2 mt-4" data-sd-id="99">
                           <div class="space-y-1.5" data-sd-id="100">
                              <span class="flex items-center gap-1.5 text-[#fcfcfc] font-mono font-bold text-[0.57rem] uppercase" data-sd-id="101">
                                <span class="w-1 h-1 bg-[#3e97ff] rounded-full shadow-[0_0_8px_#3e97ff]" data-sd-id="102"></span> Liquidity map
                              </span>
                              <div class="h-0.5 bg-white/10 relative overflow-hidden" data-sd-id="103">
                                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#3e97ff] to-transparent animate-[pulse_2s_infinite]" data-sd-id="104"></div>
                              </div>
                           </div>
                           <div class="space-y-1.5 opacity-50" data-sd-id="105">
                              <span class="flex items-center gap-1.5 text-[#a1a5b7] font-mono font-bold text-[0.57rem] uppercase" data-sd-id="106">
                                <span class="w-1 h-1 bg-white/30 rounded-full" data-sd-id="107"></span> Positioning
                              </span>
                              <div class="h-0.5 bg-white/5" data-sd-id="108"></div>
                           </div>
                           <div class="space-y-1.5 opacity-50" data-sd-id="109">
                              <span class="flex items-center gap-1.5 text-[#a1a5b7] font-mono font-bold text-[0.57rem] uppercase" data-sd-id="110">
                                <span class="w-1 h-1 bg-white/30 rounded-full" data-sd-id="111"></span> Order flow
                              </span>
                              <div class="h-0.5 bg-white/5" data-sd-id="112"></div>
                           </div>
                        </div>
                      </div>
                   </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Bottom Glow blobs for depth as seen in styles.css -->
        <div class="glow-blob w-[500px] h-[500px] bg-[#3e97ff] top-[-10%] left-[10%]" data-sd-id="113"></div>
        <div class="glow-blob w-[600px] h-[600px] bg-[#7239ea] bottom-[10%] right-[5%]" data-sd-id="114"></div>

      </main>
    </div>
  </div>

  <!-- Scanline effect mentioned in source -->
  <div class="fixed inset-0 pointer-events-none opacity-[0.045] bg-[linear-gradient(rgba(18,16,33,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]" data-sd-id="115"></div>


</body></html>